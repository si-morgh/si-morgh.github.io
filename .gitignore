# Jekyll build output and caches
_site/
.jekyll-cache/
.jekyll-metadata
.sass-cache/

# Bundler (.bundle/config and Gemfile.lock are tracked on purpose; installed
# gems are not). The lockfile is committed because this is a site, not a gem:
# without it every CI build re-resolves dependencies, so a new release of any
# transitive gem can break the deploy with no change on our side.
vendor/

# macOS
.DS_Store

# Editors
.idea/
*.swp

# Untouched image masters, kept locally and never published
_originals/
